sequenceDiagram
    autonumber
    actor User as Користувач
    participant Frontend
    participant Backend
    participant Bank as Bank (Шлюз)
    
    User ->> Frontend: Натискає "Підтвердити замовлення"
    activate Frontend
    
    Frontend ->> Backend: checkout(customer_id, address_id, payment_method_id)
    activate Backend
    
    Backend ->> Bank: processPayment(amount, bank_token)
    activate Bank
    Bank -->> Backend: 403 Payment Declined (Відмова)
    deactivate Bank
    
    opt Обробка відхиленого платежу

        
        Backend -->> Frontend: 402 Payment Required (Declined)
        Frontend -->> User: Показує повідомлення про відмову в оплаті
    end
    
    deactivate Backend
    deactivate Frontend